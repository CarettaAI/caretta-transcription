# Audio processing
# Model / preprocessor sample rate used by the service (model's native sample-rate)
TARGET_SR=16000

# Model selection and precision
# MODEL_NAME is currently hard-coded in code; set here if you change code to read it from env
# MODEL_NAME=nvidia/parakeet-tdt-0.6b-v3
MODEL_PRECISION=fp16
DEVICE=cuda

# Inference / batching
BATCH_SIZE=4
MAX_AUDIO_DURATION=30    # seconds
PROCESSING_TIMEOUT=60    # seconds

# Streaming tuning (latency / context / batching)
STREAM_CHUNK_MS=640               # target chunk duration in ms (default ~640ms)
STREAM_LEFT_CONTEXT_MS=9600       # left context for streaming (ms)
STREAM_RIGHT_CONTEXT_MS=2000      # right context for streaming (ms) - adds latency but improves accuracy
STREAM_MAX_UNFLUSHED_MS=5000      # force flush if no VAD end before this (ms) - transcribe long speech
STREAM_BATCH_WINDOW_MS=20         # micro-batching window for the batch worker (ms)
STREAM_MAX_BATCH=4                # max items per micro-batch
STREAM_QUEUE_CAPACITY=512         # queue capacity to apply backpressure
STREAM_ENABLE_PARTIAL_FLUSH=0     # emit mid-utterance chunks; set to 1 to keep sub-second updates

# VAD / audio chunking
SAMPLE_RATE=16000
VAD_WINDOW_SAMPLES=512            # samples per VAD window (512 @16k -> 32ms)
VAD_THRESHOLD=0.40                # probability threshold to consider speech
VAD_MIN_SILENCE_MS=400            # trailing silence (ms) considered end of utterance
VAD_SPEECH_PAD_MS=300             # context to keep before/after speech (ms)
# Note: STREAM_MAX_UNFLUSHED_MS controls maximum utterance length before forced flush

# Performance / worker tuning
# Number of parallel streaming workers / containers should be controlled by your orchestrator
# (k8s HPA / scaling policy). Keep BATCH_SIZE and STREAM_MAX_BATCH tuned for GPU memory.

# Logging
LOG_LEVEL=info
